@url = http://localhost:5114


GET {{url}}/

### cria o usuario 
POST {{url}}/user/create
Content-Type: application/json

{
  "username": "maria",
  "email": "maria@email.com",
  "password": "senha123"
}



### busca o usuario 
GET {{url}}/user/1

### cria o rotulo Faculdade para o id 1
POST {{url}}/label/create
Content-Type: application/json

{
  "name": "Faculdade  2",
  "userId": 1
}


### lista os rotulos do usuario
GET {{url}}/label/list/1

### tarefa com rotulo e prazo
POST {{url}}/tasks/create
Content-Type: application/json

{
  "name": "Trabalho final",
  "description": "API do ManagerTask",
  "dueDate": "2027-06-30T23:59:00",
  "userId": 1,
  "labelId": 1
}



### lista todas as tarefas do user 1
GET {{url}}/tasks/list/1

### busca tarefa por id
GET {{url}}/tasks/1

### update status
PATCH {{url}}/tasks/status/1

### update task
PUT {{url}}/tasks/update/3
Content-Type: application/json

{
  "name": "Ler um livro",
  "description": "um capitulo por dia",
  "isCompleted": false,
  "dueDate": "2027-01-31T00:00:00",
  "labelId": 2
}

### delete tarefa
DELETE {{url}}/tasks/delete/2




